# Database: set for PostgreSQL (e.g. Render), leave unset for SQLite (local)
# DATABASE_URL=postgresql://user:password@host:5432/database

# SQLite path (only when DATABASE_URL is not set; default: data.sqlite in server folder)
# SQLITE_PATH=./data.sqlite

# Server port (default 3001)
# PORT=3001

# Registration key for sign-up (default: 1234567)
# REGISTRATION_KEY=1234567
