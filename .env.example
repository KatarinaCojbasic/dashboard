# =============================================================================
# One place for URLs and DB – set these for local dev and for Render/production
# =============================================================================

# App / API URL (same origin when you serve app + API together, e.g. on Render)
# - Local (npm run start): http://localhost:3001
# - Render: https://your-app-name.onrender.com
# Leave empty for same-origin (relative /api) when app and API are on the same host
VITE_API_URL=http://localhost:3001

# API access token for locations-equipments (optional, for API data source)
VITE_API_ACCESS_TOKEN=token_for_accessing_data

# =============================================================================
# Server-only (in Render: add under Environment for the Web Service)
# =============================================================================
# Database: PostgreSQL on Render, or leave unset for SQLite (local file)
# DATABASE_URL=postgresql://user:password@host:5432/database
# REGISTRATION_KEY=1234567
# PORT=3001
