# =============================================================================
# One place for URLs and DB – set these for local dev and for Render/production
# =============================================================================

# Supabase (optional): if set, auth and analysis logs use Supabase; otherwise localStorage
# Get URL and anon key from Supabase project: Settings → API
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
# Registration key for Supabase sign-up (optional): if set, users must enter this key to create an account
# VITE_REGISTRATION_KEY=your-secret-key

